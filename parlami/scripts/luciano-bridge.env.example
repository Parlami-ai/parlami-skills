# ============================================================
# Luciano dashboard bridge — config template
# ============================================================
# Copy to  ~/.parlami/luciano-bridge.env  on the box that runs the OpenClaw
# gateway (the Spark) and fill it in. That file is never committed: it holds
# the client's dashboard link, channel id and the name of the token variable.
# Values here are placeholders, not real ones.
# ============================================================

# The client's growth dashboard (a Claude Dashboard artifact). Comments are
# read from, and card_answers.csv is uploaded to, this link.
DASHBOARD_URL="https://claude.ai/code/artifact/{{DASHBOARD_ARTIFACT_ID}}"
# The link the dashboard's store is written at (the Artifact tool prints it
# when it reads the dashboard: "passing url: https://claude.ai/artifact/...").
DASHBOARD_STORE_URL="https://claude.ai/artifact/{{DASHBOARD_STORE_ID}}"

# How questions reach Luciano.
#   openclaw  one chat call to the OpenClaw gateway on this box; the answer
#             comes back in the same call. Default, fewest moving parts.
#   buzz      post the question in a Buzz channel and wait for his reply in
#             the thread. Older route; needs Luciano to watch the channel.
LUCIANO_TRANSPORT=openclaw

# ── OpenClaw gateway ──────────────────────────────────────
# Local address of the gateway's OpenAI-compatible endpoint. On the Spark this
# stays on localhost: nothing is exposed. (https://... also works if the
# bridge ever runs elsewhere.) The chat completions endpoint must be enabled in
# ~/.openclaw/openclaw.json, with a gateway token.
OPENCLAW_URL=http://127.0.0.1:18789
# NAME of the env var that holds the gateway token, never the token itself.
# Export it in the cron's environment, or add OPENCLAW_GATEWAY_TOKEN=... below
# (this file is private to you).
OPENCLAW_TOKEN_ENV=OPENCLAW_GATEWAY_TOKEN
# The agent id Luciano answers as. Use the client-safe one (no shell, no file
# tools): the questions come from school staff.
OPENCLAW_AGENT=parlami

# ── Buzz (optional on the openclaw route) ─────────────────
# BUZZ_ECHO=1 posts a one-way copy of each recorded question and answer to
# BUZZ_CHANNEL_ID so you see them in #ops. Nothing is read back from it.
BUZZ_ECHO=0
BUZZ_BIN=~/buzz/target/release/buzz
BUZZ_RELAY_URL=ws://localhost:3000
BUZZ_CHANNEL_ID="{{OPS_CHANNEL_UUID}}"          # the #ops channel
# Only for LUCIANO_TRANSPORT=buzz: the hex pubkey the bridge posts as, so its
# own posts are never read as answers. Give the bridge a key of its OWN.
BUZZ_SELF_PUBKEY=""
# Only for LUCIANO_TRANSPORT=buzz: who is who in the thread, for "answered_by".
# BUZZ_NAMES="{{LUCIANO_PUBKEY}}=Luciano,{{SEAN_PUBKEY}}=Sean"

# ── Claude Code CLI (headless) ────────────────────────────
# The dashboard is reachable only through the Artifact tools, so the bridge
# shells out to `claude -p` for the read and the upload. Logged in as the
# account that owns the dashboard.
CLAUDE_BIN=claude
# CLAUDE_EXTRA_ARGS="--permission-mode bypassPermissions"

# Where state.json and card_answers.csv live.
BRIDGE_HOME=~/.parlami/luciano-bridge
